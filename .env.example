# SIH26101 - Environment Configuration Template
# Copy this file to .env and configure strong credentials for your environment.
# DO NOT commit real secrets or credentials to version control.

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Dedicated PostgreSQL Host & Port (default: 54329 for native development instance)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54329

# Superuser / Admin Credentials for provisioning local cluster
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Schema Migrator Credentials (owns database schema, runs Alembic migrations)
DB_MIGRATOR_USER=sih_migrator
DB_MIGRATOR_PASSWORD=REPLACE_WITH_STRONG_MIGRATOR_PASSWORD

# Application Runtime Credentials (least-privilege read/write role; no CREATEDB/CREATEROLE/DDL)
DB_APP_USER=sih_app_user
DB_APP_PASSWORD=REPLACE_WITH_STRONG_APP_PASSWORD

# Application Database Names
DB_DEV_NAME=sih26101_dev
DB_TEST_NAME=sih26101_test

# Primary Database Connection URLs
# Runtime application connection URL (least-privilege role):
DATABASE_URL=postgresql+psycopg://sih_app_user:REPLACE_WITH_STRONG_APP_PASSWORD@127.0.0.1:54329/sih26101_dev

# Schema migration connection URL (used by Alembic to apply DDL):
MIGRATION_DATABASE_URL=postgresql+psycopg://sih_migrator:REPLACE_WITH_STRONG_MIGRATOR_PASSWORD@127.0.0.1:54329/sih26101_dev

# Dedicated Test Database Connection URLs
TEST_DATABASE_URL=postgresql+psycopg://sih_app_user:REPLACE_WITH_STRONG_APP_PASSWORD@127.0.0.1:54329/sih26101_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://sih_migrator:REPLACE_WITH_STRONG_MIGRATOR_PASSWORD@127.0.0.1:54329/sih26101_test

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Document Vault (Configurable root, outside source code tree)
DOCUMENT_VAULT_ROOT=D:/Projects/SIH26101/vault_storage
# 256-bit KEK for envelope encryption (base64-encoded 32 bytes)
DOCUMENT_ENCRYPTION_SECRET=REPLACE_WITH_BASE64_32_BYTE_KEY

# Authentication & Security Secrets (Phase 2+)
JWT_SECRET_KEY=REPLACE_WITH_STRONG_JWT_SECRET